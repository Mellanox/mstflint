	<field name="l3_type"                         offset="0x10.16"  size="0x0.4" access="RW" enum="Grh=0x1,Ipv4=0x2,Ipv6=0x4" descr="Bitmask field indicates the supported L3 types in RoCE\;\;Bit 0: Grh\;\;Bit 1: Ipv4\;\;Bit 2: Ipv6" />
