	<field name="stc_action_type_1"               offset="0x10.0"   size="0x4.0" access="RW" enum="PSP_DECRYPT=0x1,FUNCTION=0x4,EXECUTE_ASO_32=0x8,PACKET_OP=0x80,GEN_CQE=0x100,FLOW_TIMESTAMP=0x200,FIELD_XOR_FIELD=0x400,FIELD_SUB_FIELD=0x800,FIELD_AND_FIELD=0x1000,FIELD_FFS=0x2000,FLOW_SEMAPHORE=0x8000,TIMER=0x10000,RIA=0x20000" descr="Bitmask indicating support for STC action_type values.\;Set bit indicates the action_type value is supported.\;Other values appear in stc_action_type_0, stc_action_type_2, stc_action_type_3.\;\;bit 00: PSP_DECRYPT \;\;bit 02: FUNCTION \;\;bit 03: EXECUTE_ASO_32 \;\;bit 07: PACKET_OP \;\;bit 08: GEN_CQE \;\;bit 09: FLOW_TIMESTAMP \;\;bit 10: FIELD_XOR_FIELD \;\;bit 11: FIELD_SUB_FIELD \;\;bit 12: FIELD_AND_FIELD \;\;bit 13: FIELD_FFS \;\;bit 15: FLOW_SEMAPHORE \;\;bit 16: TIMER \;\;bit 17: RIA" />
	<field name="stc_action_type_0"               offset="0x14.0"   size="0x4.0" access="RW" enum="NOP=0x1,FIELD_COPY=0x20,FIELD_SET=0x40,FIELD_ADD=0x80,REMOVE_WORDS=0x100,HEADER_REMOVE=0x200,HEADER_INSERT=0x800,FLOW_TAG=0x1000,HEADER_MODIFY_LIST=0x4000,IPSEC_ENCRYPT=0x10000,IPSEC_DECRYPT=0x20000,EXECUTE_ASO=0x40000,TRAILER=0x80000,COUNT=0x100000,EXE_CTRL=0x4000000,FIELD_ADD_FIELD=0x8000000,MACSEC_ENCRYPT=0x20000000,MACSEC_DECRYPT=0x40000000,PSP_ENCRYPT=0x80000000" descr="Bitmask indicating support for STC action_type values.\;Set bit indicates the action_type value is supported.\;Other values appear in stc_action_type_1, stc_action_type_2, stc_action_type_3.\;\;bit 00: NOP\;\;bit 05: FIELD_COPY\;\;bit 06: FIELD_SET\;\;bit 07: FIELD_ADD\;\;bit 08: REMOVE_WORDS\;\;bit 09: HEADER_REMOVE\;\;bit 11: HEADER_INSERT\;\;bit 12: FLOW_TAG\;\;bit 14: HEADER_MODIFY_LIST\;\;bit 16: IPSEC_ENCRYPT\;\;bit 17: IPSEC_DECRYPT\;\;bit 18: EXECUTE_ASO\;\;bit 19: TRAILER\;\;bit 20: COUNT\;\;bit 26: EXE_CTRL\;\;bit 27: FIELD_ADD_FIELD\;\;bit 29: MACSEC_ENCRYPT\;\;bit 30: MACSEC_DECRYPT\;\;bit 31: PSP_ENCRYPT" />
