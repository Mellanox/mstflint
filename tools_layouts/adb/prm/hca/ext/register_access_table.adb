	<field name="eye_diag_dim"                    offset="0x4.24"   size="0x0.3" access="RW" descr="dimensions of eye scan matrix in the format of height_dim x width_dim0 - 16x16 (256 err val)1 - 32x32 (1024 err val)2 - 32x64 (1024 err val)3 - 64x32 (2048 err val)" />
	<field name="err_res_scale"                   offset="0x4.27"   size="0x0.2" access="RW" descr="error res multiplier for err_res_base field0 - exponential scale1 - linear scale2-3 - reserved" />
	<field name="destructive_ctrl"                offset="0x4.29"   size="0x0.1" access="RW" descr="0 - non destructive scan1 - destructive scanNote: if non destructive scan is not supported this field is ignored and\;a destructive scan will be operated" />
	<field name="last_scan"                       offset="0x4.30"   size="0x0.1" access="WO" descr="set to ‘1’ when performing last eye scan for lane.For example: when scanning 3 eyes in the order of up, mid, down. field\;should be set when scanning down eye.If scanning only 1 eye, field should be set." />
