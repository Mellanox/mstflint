	<field name="entropy_calc_cap"                offset="0x4.30"   size="0x0.1" access="RO" descr="Specifies the egress tunnel protocol entropy calculation enable/disable\;capabilities of the local port.A bit set to 1 for affirmation of supported enable/disable capability:" />
