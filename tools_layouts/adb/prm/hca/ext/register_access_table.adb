	<field name="cap_pin_6_mode"                  offset="0xc.16"   size="0x0.4" access="RO" enum="support_pps_in=0x1,support_pps_out=0x2,support_virtual_pin=0x4" descr="Bit0: support_pps_inBit1: support_pps_outBit2: support_virtual_pin" />
