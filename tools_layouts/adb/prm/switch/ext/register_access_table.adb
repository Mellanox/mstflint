	<field name="usipv4"                          offset="0x28.0"   size="0x4.0" access="RW" descr="Underlay Source IPv4 address of the NVEFor Spectrum family: usipv4 must not be modified under traffic of NVE\;tunneling encapsulation." />
	<field name="usipv6"                          offset="0x30.0"   size="0x10.0" access="RW" high_bound="3" low_bound="0" descr="Underlay Source IPv6 address of the NVEFor Spectrum family: usipv6 must not be modified under traffic of NVE\;tunneling encapsulation." />
	<field name="header0_bit_set"                 offset="0x40.0"   size="0x4.0" access="RW" descr="For VXLAN/VXLAN-GPE/GENEVE header:Set bits to ‘1’The device will do an OR function with the default header0Header0 is the first 4B in the headerReserved when type = 3 (NVGRE)" />
	<field name="vxlan_hdr_bits_en"               offset="0x44.0"   size="0x0.1" access="WO" descr="VXLAN Header bits Enable.When set vxlan_hdr_bits are valid." />
	<field name="gpe_hdr_bits_en"                 offset="0x44.1"   size="0x0.1" access="WO" descr="GPE Header bits Enable.When set gpe_hdr_bits are valid." />
	<field name="geneve_hdr_bits_en"              offset="0x44.2"   size="0x0.1" access="WO" descr="GENEVE Header bits Enable.When set geneve_hdr_bits are valid." />
