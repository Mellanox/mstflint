	<field name="tuning_override"                 offset="0x0.0"    size="0x0.1" access="WO" descr="When set, port will override tuning process upon following link-up\;command (PAOS.admin_status = UP).Cleared by FW once PAOS.admin_status = UP command is set.The tuning_override is recommended to be set when port operational\;status is UP (PAOS.oper_status=0x1).If the field is set while operational status is DOWN\;(PAOS.oper_status=0x2), port will do best effort of fast linkup on the\;possible parts of the link (that is, known internal links that cannot\;change)." />
	<field name="flua_cap"                        offset="0x0.2"    size="0x0.1" access="RO" descr="When set, indicates if flua_en, flua_guar_sec, flua_polling_sec,\;flua_allowed_ber, flu_always_oper is supported and valid." />
	<field name="flua_we_mask"                    offset="0x0.3"    size="0x0.4" access="WO" enum="flua_en=0x1,flua_allowed_ber=0x2,flua_polling_sec=0x4,flua_guar_sec=0x8" descr="Bitmask for all flua fiels. When bit is set in mask, the relevant field\;configuration is valid. Otherwise, field ignores the value.Bit 0: flua_enbit 1: flua_allowed_berBit 2: flua_polling_secBit 3: flua_guar_sec" />
	<field name="lp_msb"                          offset="0x0.12"   size="0x0.2" access="INDEX" descr="Local port number [9:8]" />
	<field name="local_port"                      offset="0x0.16"   size="0x0.8" access="INDEX" descr="Local port number." />
	<field name="keep_phy_setting"                offset="0x4.0"    size="0x0.1" access="WO" descr="When Set, The port will keep the same phy setting upon link down event\;that occurs only upon link down command of peer port. In the event of\;Down command/cable disconnect, entire link up flow will be initialized.NOTE: This mode can be configured only when PTYS.an_disable_admin is set\;(i.e. AN is disabled).NOTE: if physical environment was changed (i.e. replacement of module,\;temp change, etc) there is a possibility that link won’t be established\;or will be established with high BER" />
	<field name="flua_en"                         offset="0x4.4"    size="0x0.2" access="RW" enum="device_default_behavior=0x0,enable_fast_linkup_always=0x1,disable_fast_linkup_always=0x2" descr="Get valid only if flua_cap is set.Set is valid only if flua_cap and flua_we are set.valid only if flua_cap is set0: device_default_behavior1: enable_fast_linkup_always2: disable_fast_linkup_alwaysWhen enabled, fast linkup attempt will always be performed. On fast\;linkup failure, regular linkup flow will be performed.flu configuration is ignored when flu_always enabled" />
	<field name="flua_oper"                       offset="0x4.6"    size="0x0.2" access="RO" enum="fast_linkup_always_was_not_performed=0x0,fast_linkup_always_was_performed=0x1" descr="Valid only if flua_cap is set.Fast link Up always operational satus0: fast_linkup_always_was_not_performed1: fast_linkup_always_was_performed" />
	<field name="flua_allowed_ber"                offset="0x4.8"    size="0x0.8" access="RW" descr="BER exponent threshold for allowed ber during the guard period." />
	<field name="flua_polling_sec"                offset="0x4.16"   size="0x0.8" access="RW" descr="Get valid only if flua_cap is set.Set is valid only if flua_cap and flua_we are set.Polling allowed time in 2.5 sec granularity.When fast linkup always is enabled.Determines the amount of time to try fast-linkup during polling state.\;when timer expires in polling state, regular linkup will be performed" />
	<field name="flua_guar_sec"                   offset="0x4.24"   size="0x0.5" access="RW" descr="Get valid only if flua_cap is set.Set is valid only if flua_cap and flua_we are set.Guard peiod in sec.When fast linkup always is enabled, determines the amount of time after\;link is up that if the link drops or BER threshold is met, next linkup\;will not perform fast-linkup." />
