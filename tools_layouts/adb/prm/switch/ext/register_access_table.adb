	<field name="weme"                            offset="0x8.29"   size="0x0.1" access="OP" descr="Warning Events Modify Set Enable:0: all fields are set1: only set tee, ctlee, and ctree. All other fields reserved.Note: It is invalid to set both weme and sdme in the same operation." />
