	<field name="vxlan_hdr_bits"                  offset="0x48.0"   size="0x8.0" subnode="uint64" access="RW" descr="Spectrum-4 only.Bitmask to raise DISCARD_DEC_NVE_OPTIONS.If bit i = 0, the corresponding bit in vxlan header will not be checked\;according to DISCARD_DEC_NVE_OPTIONSIf bit i = 1, and the corresponding bit in xvlan header is 1, the\;DISCARD_DEC_NVE_OPTIONS will be raised.E.g Reserved bit ≠0 that should not raise the check should be set to 0.Reserved when vxlan_hdr_bits_en = 0.Default value is 0xF7FFFFFF_000000FF." />
	<field name="gpe_hdr_bits"                    offset="0x50.0"   size="0x8.0" subnode="uint64" access="RW" descr="Spectrum-4 only.Bitmask to raise DISCARD_DEC_NVE_OPTIONS.If bit i = 0, the corresponding bit in vxlan header will not be checked\;according to DISCARD_DEC_NVE_OPTIONSIf bit i = 1, and the corresponding bit in gpe header is 1, the\;DISCARD_DEC_NVE_OPTIONS will be raised.E.g Reserved bit ≠0 that should not raise the check should be set to 0.Reserved when gpe_hdr_bits_en = 0.Default value is 0xC0FFFF00_000000FF." />
	<field name="geneve_hdr_bits"                 offset="0x58.0"   size="0x8.0" subnode="uint64" access="RW" descr="Spectrum-4 only.Bitmask to raise DISCARD_DEC_NVE_OPTIONS.If bit i = 0, the corresponding bit in vxlan header will not be checked\;according to DISCARD_DEC_NVE_OPTIONSIf bit i = 1, and the corresponding bit in geneve header is 1, the\;DISCARD_DEC_NVE_OPTIONS will be raised.E.g Reserved bit ≠0 that should not raise the check should be set to 0.Reserved when geneve_hdr_bits_en = 0.Default value is 0x003F0000_000000FF." />
	<field name="nvgre_hdr_bits"                  offset="0x60.0"   size="0x4.0" access="RW" descr="Spectrum-4 only.Bitmask to raise DISCARD_DEC_NVE_OPTIONS.If bit i = 0, the corresponding bit in vxlan header will not be checked\;according to DISCARD_DEC_NVE_OPTIONSIf bit i = 1, and the corresponding bit in nvgre header is 1, the\;DISCARD_DEC_NVE_OPTIONS will be raised.E.g Reserved bit ≠0 that should not raise the check should be set to 0.Reserved when nvgre_hdr_bits_en = 0.Default value is 0x0FF80000." />
</node>

